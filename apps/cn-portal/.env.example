NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 与 Creator Portal / Design Engine 共用 ERP；必填，不再提供源码兜底。
ERP_API_BASE_URL=https://your-erp-host/ideamax
ERP_APP_KEY=your-erp-app-key
ERP_SECRET_KEY=your-erp-secret-key

# ERP 图片包含其他 CDN 的绝对 URL 时，明确配置允许的 origin（逗号分隔）。
ERP_IMAGE_ALLOWED_ORIGINS=

# 邮件（注册验证 / 找回密码）里回跳本站用的对外地址。不配置时取请求来源；
# Render 环境组里的 APP_URL 指向 Creator Portal，不能复用。该地址需加入 Supabase 的 Redirect URLs。
CN_PORTAL_PUBLIC_URL=
